{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.2/.schema/devbox.schema.json",
  "packages": [
    "jekyll@latest",
    "bundler@latest"
  ],
  "shell": {
    "init_hook": [
      "bundle install"
    ],
    "scripts": {
      "serve": [
        "bundle exec jekyll serve"
      ],
      "typst-posts": [
        "bundle exec \"$(head -1 \"$(which bundle)\" | cut -c3-)\" scripts/typst-posts.rb 2>/dev/null"
      ]
    }
  }
}
